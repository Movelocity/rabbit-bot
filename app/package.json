{
  "name": "rabbit-bot",
  "version": "0.1.0",
  "description": "聊天池 Agent (pi + 飞书)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ctl": "tsx src/ctl.ts",
    "demo": "tsx src/sim.ts --demo",
    "doctor": "bash scripts/doctor.sh",
    "inject": "bash scripts/inject.sh",
    "sbx": "bash scripts/sbx.sh",
    "sim": "tsx src/sim.ts",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "idle": "node scripts/idle.mjs",
    "rb": "tsx src/cli.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.2",
    "pi-death-loop-guard": "^0.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "fsevents@2.3.3": true
  },
  "bin": {
    "rb": "bin/rb"
  }
}
