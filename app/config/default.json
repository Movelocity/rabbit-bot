{
  "timezone": "Asia/Shanghai",
  "dataDir": "./data",
  "logDir": "./logs",
  "scheduler": {
    "tickMs": 180000,
    "activeTickMs": 60000,
    "activeWindowMs": 600000,
    "debounceMs": 30000,
    "debounceMaxWaitMs": 120000,
    "watchdogMs": 5000,
    "overdueGraceMs": 2000,
    "batchToTick": true
  },
  "send": {
    "confirmWaitMs": 1000,
    "confirmViaApi": false
  },
  "context": {
    "recentContextMessages": 8,
    "maxUnreadPerPool": 50,
    "maxMemoriesPerUser": 8
  },
  "handoff": {
    "contextTokenLimit": 60000,
    "sessionTokenLimit": 600000
  },
  "loopGuard": {
    "impl": "pi-death-loop-guard",
    "warnThreshold": 5,
    "blockThreshold": 10,
    "abortAfterBlocks": 1
  },
  "limits": {
    "dailyLlmCalls": 300,
    "dailyTokens": 2000000,
    "turnTimeoutMs": 300000,
    "capNotice": {
      "enabled": true,
      "text": "〔系统〕今天的额度用完了，我先歇一会儿——你说的话我记着，回头接着聊。",
      "oncePerDay": true
    },
    "errorNotice": {
      "enabled": true,
      "text": "〔系统〕我这边出了点问题（{reason}）。这条不是她说的——你刚才那句话我记着，等恢复了我再回。",
      "dedupeMinutes": 60
    },
    "cacheReadRate": 0.1
  },
  "plans": {
    "missedPolicy": "catchup",
    "missedGraceMs": 86400000
  },
  "llm": {
    "provider": "deepseek",
    "model": "deepseek-flash",
    "thinkingLevel": "off",
    "maxRetries": 2
  },
  "adapters": {
    "feishu": {
      "enabled": true,
      "domain": "feishu",
      "fetchSenderName": true,
      "reactions": true,
      "logRawEmoji": true
    }
  },
  "emoji": {
    "table": "./config/emoji-feishu.json",
    "map": {}
  },
  "media": {
    "maxEdge": 1024,
    "maxBytes": 512000,
    "maxImagesInContext": 4
  },
  "inject": {
    "port": 3737
  },
  "agent": {
    "name": "小池",
    "persona": "你是一个自然、简短、有分寸的聊天伙伴。"
  },
  "sandbox": {
    "dir": "data/sandbox",
    "maxFileBytes": 262144,
    "maxFiles": 200,
    "maxReadChars": 8000,
    "shell": {
      "enabled": true,
      "container": "rabbit-bot-sbx",
      "image": "rabbit-bot-sandbox:latest",
      "timeoutMs": 10000,
      "maxOutputChars": 8000,
      "network": "bridge",
      "volumes": [
        {
          "host": "data/sandbox",
          "container": "/work",
          "mode": "rw"
        }
      ]
    }
  },
  "tide": {
    "enabled": true,
    "dailyCap": {
      "L1": 2,
      "L2": 1
    },
    "wave": {
      "enabled": false,
      "delayMin": 10,
      "peakMin": 20,
      "thr": 0.5,
      "wUser": 0.4,
      "wSelf": 0.25,
      "wIdle": 0.55,
      "idleRampH": 24,
      "idleStartH": 6,
      "horizonH": 24,
      "idleExemptMin": 180,
      "ratio": 0.5,
      "maxStages": 3,
      "maxWakesPerDay": 8,
      "dailyTokens": 300000,
      "quietStart": "00:30",
      "quietEnd": "08:00"
    },
    "energy": {
      "enabled": true,
      "cap": 8,
      "floor": 1,
      "halfH": 8,
      "restH": 1,
      "costInit": 1.0,
      "costAnswer": 0.1,
      "gain": 1.0,
      "mid": 3.8,
      "scale": 0.9,
      "activeStartH": 8,
      "activeEndH": 24,
      "hotMin": 3,
      "coldMin": 240
    }
  }
}
